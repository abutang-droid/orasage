[Unit]
Description=OraSage Bazi Calculator (Vite + Express + tRPC)
After=network.target mariadb.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/orasage/bazi
EnvironmentFile=-/opt/orasage/bazi/.env
Environment=NODE_ENV=production
Environment=PORT=3110
# CMS 变量内联，避免加载根目录 .env 覆盖 bazi/.env 中的 DATABASE_URL
Environment=CMS_INTERNAL_URL=http://127.0.0.1:3120/cms
Environment=CMS_PUBLIC_URL=https://cms.orasage.com/cms
# 报告 HTML 持久目录（dist/ 每次部署重建，不能存业务产物）
Environment=REPORTS_DIR=/var/lib/orasage/bazi-reports
ExecStart=/usr/local/bin/node dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
