# OriCosmos 并行环境 — 共享环境变量模板
# 用途：新 Google VM（oricosmos.com），与 orasage.com 生产并存
# 复制到 /opt/orasage/.env，并同步到各 App 的 .env（JWT / URL 必须一致）

# ── 站点 apex（构建导航 / 跨域链接用；deploy 脚本会按 NGINX_SITE 写入）──
SITE_APEX=oricosmos.com
NEXT_PUBLIC_SITE_APEX=oricosmos.com
VITE_SITE_APEX=oricosmos.com

# ── 认证（本环境内所有 App 必须一致；可与 orasage 生产不同） ──
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_COOKIE_NAME=orasage_token
JWT_COOKIE_DOMAIN=.oricosmos.com
COOKIE_DOMAIN=.oricosmos.com

# ── 公网 URL ─────────────────────────────────────────────────
APP_URL=https://oricosmos.com

AUTH_URL=https://auth.oricosmos.com
AUTH_INTERNAL_URL=http://127.0.0.1:3101

SHOP_URL=https://shop.oricosmos.com
SHOP_INTERNAL_URL=http://127.0.0.1:3102

BAZI_URL=https://bazi.oricosmos.com
BAZI_INTERNAL_URL=http://127.0.0.1:3110

ZIWEI_URL=https://ziwei.oricosmos.com
ZIWEI_INTERNAL_URL=http://127.0.0.1:3111

TAROT_URL=https://tarot.oricosmos.com
TAROT_INTERNAL_URL=http://127.0.0.1:3112

# CMS：公网 cms 子域重定向；管理入口 admin.oricosmos.com/cms
CMS_PUBLIC_URL=https://admin.oricosmos.com/cms
CMS_INTERNAL_URL=http://127.0.0.1:3120/cms

ADMIN_URL=https://admin.oricosmos.com

# ── 数据库（本机 PostgreSQL，勿连 orasage 生产库） ───────────
DATABASE_URL=postgresql://orasage:CHANGE_ME@127.0.0.1:5432/orasage_auth
# bazi/.env  → .../orasage_bazi
# tarot/.env → .../orasage_tarot
# cms/.env   → .../orasage_cms（PAYLOAD_SECRET 须另设，勿等于 JWT_SECRET）
REDIS_URL=redis://127.0.0.1:6379

# ── 支付 ─────────────────────────────────────────────────────
# world = World App MiniKit.pay (WLD wallet). mock / stripe also supported.
PAYMENT_MODE=world
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── World Mini App (https://docs.world.org/mini-apps) ───────────
WORLD_AUTH_REQUIRED=true
NEXT_PUBLIC_WORLD_AUTH_REQUIRED=true
WORLD_PAY_ENABLED=true
NEXT_PUBLIC_WORLD_PAY_ENABLED=true
# From developer.worldcoin.org / developer.world.org portal
WORLD_APP_ID=app_8001cef1f043f4b7bb48304053b946ac
NEXT_PUBLIC_WORLD_APP_ID=app_8001cef1f043f4b7bb48304053b946ac
# Must match Developer Portal App URL exactly (SIWE URI; no trailing slash/query)
WORLD_APP_URL=https://tarot.oricosmos.com
NEXT_PUBLIC_WORLD_APP_URL=https://tarot.oricosmos.com
# World ID relying party (IDKit / proof-of-humanity)
WORLD_RP_ID=rp_a034015870525413
NEXT_PUBLIC_WORLD_RP_ID=rp_a034015870525413
# Portal action id (Incognito Actions)
WORLD_ID_ACTION=manto-tarot
NEXT_PUBLIC_WORLD_ID_ACTION=manto-tarot
NEXT_PUBLIC_WORLD_IDKIT_ENABLED=true
# RP signing key from Developer Portal → World ID → RP (0x + 64 hex). Server only.
WORLD_RP_SIGNING_KEY=
# Optional: Dev Portal API key for Get Transaction Bearer auth.
# Do NOT put the RP signing key (0x + 64 hex) here — that is WORLD_RP_SIGNING_KEY.
DEV_PORTAL_API_KEY=
WORLD_DEV_PORTAL_API_KEY=
# Merchant wallet that receives MiniKit.pay (WLD)
WORLD_PAYMENT_TO_ADDRESS=0x7819e52eb0239cb00abd70bd631683a9a6942041
NEXT_PUBLIC_WORLD_PAYMENT_TO_ADDRESS=0x7819e52eb0239cb00abd70bd631683a9a6942041

# ── 前台计价：USDT（=USD）+ WOLD ────────────────────────────────
CNY_TO_USD_RATE=7.2
WOLD_PER_USDT=1
