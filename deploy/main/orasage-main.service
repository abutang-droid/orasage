[Unit]
Description=OraSage Main Portal (Next.js)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/orasage/main
EnvironmentFile=/opt/orasage/.env
Environment=NODE_ENV=production
# Tunnel ingress stays on :3100 via deploy/nginx/orasage-main-tunnel-split.conf
Environment=PORT=3105
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/local/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
