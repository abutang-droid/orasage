# PostgreSQL
DATABASE_URL="postgresql://orasage:changeme@127.0.0.1:5432/orasage_tarot"

# Shared with auth-service (orasage_token bridge)
JWT_SECRET="change-me-at-least-32-characters-long"

# Merit share/referral path (default: enabled). Set to false to disable referral bind + share rewards.
MERIT_SHARE_PATH_ENABLED=true

# AI 解读（必需；否则单牌/三牌 brief、full-report 等走 LLM 的路径失效）
DEEPSEEK_API_KEY=
# 或 OPENAI_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL
